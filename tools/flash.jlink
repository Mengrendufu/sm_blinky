// J-Link Commander command file: what runs after the target is connected.
// Connection parameters stay on the command line, one fact in one place
// (SEGGER also recommends passing -device there):
//   JLink.exe -device STM32F103ZE -if SWD -speed 4000 -autoconnect 1
//             -ExitOnError 1 -NoGui 1 -CommandFile tools\flash.jlink
// loadfile erases and verifies the flash it writes, so a plain "erase" is
// not needed. The artifact path is absolute; change it if the build moves.
// J-Link is a Windows program while the build lives in WSL, so the path is
// the UNC view of the WSL tree (\\wsl.localhost\<distro>\...).

r
h
// Both images, bootloader first. loadfile erases only the sectors it writes,
// and the two live at 0x08000000 (16 KB) and 0x08004000 (496 KB), so they
// do not overlap.
loadfile \\wsl.localhost\Ubuntu-24.04\home\sunnymatato\projects\sm_repos\embedded\hmi\sm_blinky\build\debug\bootloader.hex
loadfile \\wsl.localhost\Ubuntu-24.04\home\sunnymatato\projects\sm_repos\embedded\hmi\sm_blinky\build\debug\sm_blinky.hex
r
g
qc
