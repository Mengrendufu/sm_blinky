# Read by clangd before anything a command line hands it.
#
# The compile database is written by tools/ide_db.sh: it keeps one entry per
# source that this project compiles, and it carries the compiler's own include
# directories, which clangd cannot find by itself. Naming the directory here
# means the search stops exactly there, whatever directory the editor opens.
CompileFlags:
  CompilationDatabase: build/debug
  # --specs comes from newlib and clang does not know it.
  Remove:
    - --specs=*
Diagnostics:
  Suppress:
    - drv_unknown_argument
