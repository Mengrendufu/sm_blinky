# Read by clangd before anything a command line hands it.
#
# The compile database is generated by cmake --preset debug into build/debug.
# Naming the directory here means the search stops exactly there, whatever
# directory the editor opens, and nothing has to be placed in the repository
# root.
#
# The compiler's own system headers (newlib's sys/types.h and friends) cannot
# be supplied from this file and are not in the database as CMake writes it:
# clangd drops -isystem flags a config file adds, a Compiler: key does nothing
# on 22.1.0, and CMake filters the compiler's implicit include directories out
# of the commands. tools/ide_db.sh closes that gap by appending them to the
# generated entries; with it run, no editor-side flag is needed.
CompileFlags:
  CompilationDatabase: build/debug
  # --specs comes from newlib and clang does not know it.
  Remove:
    - --specs=*
Diagnostics:
  Suppress:
    - drv_unknown_argument
